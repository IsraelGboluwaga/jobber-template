# Copy to .env for local runs:  cp .env.example .env
# In GitHub Actions these are injected from encrypted repo secrets, NOT from a file.
# NEVER commit a real .env — it is gitignored.

# DeepSeek API key (https://platform.deepseek.com) — used by the OpenAI-compatible client.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Notion internal integration token, scoped to ONLY the jobs database (see README).
NOTION_TOKEN=ntn_your-notion-token

# The Notion database id (the 32-char id from the database URL).
NOTION_DATABASE_ID=your-database-id

# ntfy topic to POST run notifications to. Defaults to config.yaml's
# notify.ntfy_topic; set here only to override.
NTFY_TOPIC=your-unique-job-alert-topic

# ONLY for scripts/import_cv.py (one-time CV import). Not used by the daily run.
# The Notion page id holding your resume — share this page with the same
# integration as NOTION_TOKEN above (page -> ••• -> Connections -> add integration).
CV_NOTION_PAGE_ID=your-notion-page-id
